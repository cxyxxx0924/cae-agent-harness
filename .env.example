# 复制此文件为 .env 并填入实际值（.env 不提交 Git）

# ── 大模型（三选一，通过 LLM_BASE_URL 切换） ─────────────────────────────
# DeepSeek（默认）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# QWen / 通义千问（取消注释以启用）
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DEEPSEEK_API_KEY=sk-xxxxxxxx（DashScope API Key）

# Ollama 本地模型（取消注释以启用）
# LLM_BASE_URL=http://localhost:11434/v1
# DEEPSEEK_API_KEY=ollama

# ── CAE 软件路径（Windows 实际安装路径） ─────────────────────────────────
CAE_WORKDIR=D:\cae_projects\airbag
CAE_HMBATCH=C:\Altair\2023\hwdesktop\hw\bin\win64\hmbatch.exe
CAE_LSDYNA=C:\LSTC\ls971_s_R13.1_winx64_ifort131.exe
CAE_HYPERVIEW=C:\Altair\2023\hwdesktop\hw\bin\win64\hw.exe

# ── Agent Web UI 端口（可选，默认 3080） ─────────────────────────────────
# DSH_PORT=3080

# -- HyperWorks / Qilan Solve (Python MCP) ------------------------------------
# Altair HyperWorks install root (required by hyperworks-mcp)
HYPERWORKS_HOME=C:\Altair\2023
# LS-DYNA binary path (qilan-solve-mcp reads LSDYNA_BIN)
# LSDYNA_BIN is auto-mapped from CAE_LSDYNA above; set explicitly to override
# LSDYNA_BIN=C:\LSTC\ls971_s_R13.1_winx64_ifort131.exe
