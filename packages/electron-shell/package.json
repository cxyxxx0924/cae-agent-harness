{
  "name": "@cae/electron-shell",
  "version": "0.1.0",
  "description": "Electron desktop shell for CAE Agent (wraps dsh web UI)",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && electron .",
    "test": "npm run build && node --test test/*.test.cjs",
    "dist:win": "node scripts/package-windows.cjs",
    "dist:win:zip": "node scripts/package-windows.cjs --zip",
    "dist:win:installer": "node scripts/package-windows.cjs --installer",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5"
  },
  "devDependencies": {
    "@types/node": "22.15.29",
    "electron": "32.2.5",
    "electron-builder": "25.1.8",
    "typescript": "5.6.3"
  },
  "build": {
    "appId": "com.cae.agent",
    "productName": "CAE Agent",
    "copyright": "CAE Agent",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "resources/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "CAE-Agent-${version}-Windows-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "runAfterFinish": false,
      "installerLanguages": ["zh_CN", "en_US"],
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "artifactName": "CAE-Agent-${version}-Windows-x64-Setup.${ext}"
    },
    "extraResources": [
      {
        "from": "../../out/windows/runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ]
  }
}
